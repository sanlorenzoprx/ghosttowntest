{
  "name": "lit-ghost-town",
  "version": "1.0.0",
  "description": "LIT Ghost Town Test - Validate your startup idea before building",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "wrangler dev --env development --local",
    "verify:blueprint": "node scripts/verify-blueprint-source.mjs",
    "pretype-check": "npm run verify:blueprint",
    "type-check": "tsc --noEmit",
    "pretest": "npm run verify:blueprint",
    "test": "vitest run",
    "prebuild": "npm run verify:blueprint",
    "build": "vite build",
    "preview": "vite preview",
    "preworker:check": "npm run verify:blueprint",
    "worker:check": "wrangler deploy --dry-run --env development",
    "preworker:check:acceptance": "npm run verify:blueprint",
    "worker:check:acceptance": "wrangler deploy --dry-run --env acceptance",
    "acceptance:check": "npm run type-check && npm run test && npm run build && npm run worker:check && npm run worker:check:acceptance",
    "check": "npm run type-check && npm test && npm run build && npm run worker:check",
    "roadmap:autopilot": "node scripts/roadmap-autopilot-wrapper.mjs",
    "roadmap:status": "node --require ./scripts/roadmap-windows-spawn-compat.cjs scripts/roadmap-master-autopilot.mjs --status",
    "roadmap:reset": "node --require ./scripts/roadmap-windows-spawn-compat.cjs scripts/roadmap-master-autopilot.mjs --reset",
    "roadmap:production": "node scripts/roadmap-autopilot-wrapper.mjs",
    "roadmap:quality": "node scripts/commercial-quality-roadmap-autopilot.mjs",
    "roadmap:freeze": "node scripts/roadmap-infrastructure-freeze.mjs"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260804.1",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.16",
    "playwright": "^1.55.0",
    "postcss": "^8.5.23",
    "tailwindcss": "^3.3.5",
    "typescript": "^5.3.3",
    "vite": "^6.4.3",
    "vitest": "^4.1.9",
    "wrangler": "^4.119.0"
  },
  "overrides": {
    "esbuild": "^0.25.0",
    "undici": "^6.21.1",
    "ws": "^8.18.1"
  }
}
